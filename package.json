{
  "name": "graligen",
  "description": "A clean, grayish CSS library",
  "version": "0.0.1",
  "homepage": "https://parkersprouse.me/graligen",
  "license": "MIT",
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "main": "dist/gralig.css",
  "targets": {
    "main": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parkersprouse/graligen.git"
  },
  "bugs": {
    "url": "https://github.com/parkersprouse/graligen/issues"
  },
  "author": {
    "name": "Parker Sprouse",
    "email": "parker@parkersprouse.me"
  },
  "contributors": [
    {
      "name": "Parker Sprouse",
      "email": "parker@parkersprouse.me"
    },
    {
      "name": "Eren Guldas",
      "email": "erenguldas@gmail.com"
    }
  ],
  "keywords": [
    "clean css",
    "clean design",
    "css library",
    "css",
    "frontend",
    "gray",
    "grayish",
    "minimal",
    "pure",
    "simplistic",
    "ui"
  ],
  "scripts": {
    "start": "run-p clean:dev serve",
    "serve": "parcel examples/index.html --dist-dir dev --open --no-cache",
    "build": "run-s test clean parcel:build minify",
    "parcel:build": "parcel build --dist-dir dist scss/gralig.scss --no-optimize --no-cache",
    "clean": "rimraf dist/*",
    "clean:dev": "rimraf dev/*",
    "minify": "cleancss -o dist/gralig.min.css dist/gralig.css",
    "lint:scss": "stylelint -s --fix --formatter=verbose 'scss/**/*.scss'",
    "test": "run-s lint:scss"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.8.2",
    "autoprefixer": "^10.4.13",
    "clean-css-cli": "^5.6.3",
    "css-loader": "^7.1.4",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.8.2",
    "patch-package": "^6.5.0",
    "postcss": "^8.5.23",
    "postcss-cli": "^9.1.0",
    "postcss-preset-env": "^11.3.0",
    "postcss-safe-parser": "^7.0.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.4",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-declaration-strict-value": "^1.10.11",
    "stylelint-order": "^5.0.0"
  },
  "files": [
    "dist",
    "scss",
    "README.md"
  ],
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "prettier": {
    "printWidth": 100
  }
}
